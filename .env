# Application Port
# The port on your host machine to access the Spring Boot app
APP_PORT=8102
# If you run the order-service directly (without Docker), this value can be used
# by Spring via SERVER_PORT to override server.port in application.yml
SERVER_PORT=8181

# Database Port
# The port on your host machine to access the PostgreSQL database
DB_PORT=5449

# Database Credentials
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# ========================
# Order Service overrides
# These environment variables map 1:1 to placeholders defined under
# order-service.* in order-service/order-container/src/main/resources/application.yml
# Uncomment and adjust as needed to override the defaults from application.yml

ORDER_SERVICE_DATABASE_HOST=localhost
#ORDER_SERVICE_DATABASE_PORT=5432
ORDER_SERVICE_DATABASE_PORT=5449
ORDER_SERVICE_DATABASE_NAME=postgres
ORDER_SERVICE_DATABASE_SCHEMA=order
ORDER_SERVICE_DATABASE_USERNAME=postgres
ORDER_SERVICE_DATABASE_PASSWORD=admin



# ========================
# CUSTOMER Service overrides
# These environment variables map 1:1 to placeholders defined under
# customer-service.* in customer-service/src/main/resources/application.yml
# Uncomment and adjust as needed to override the defaults from application.yml

CUSTOMER_SERVICE_DATABASE_HOST=localhost
#CUSTOMER_SERVICE_DATABASE_PORT=5432
CUSTOMER_SERVICE_DATABASE_PORT=5449
CUSTOMER_SERVICE_DATABASE_NAME=postgres
CUSTOMER_SERVICE_DATABASE_SCHEMA=customer
CUSTOMER_SERVICE_DATABASE_USERNAME=postgres
CUSTOMER_SERVICE_DATABASE_PASSWORD=admin